iptionTop":"","descriptionTopHide":true,"description":"<p>Es werden die Anstellungen aller Personen berücksichtigt, die im Unterricht in öffentlich finanzierten Mittelschulen und Berufsfachschulen tätig sind.</p><p>Die Daten werden per Stichtag 15.9. erhoben und geben jeweils den Bestand an diesem Tag wieder.</p><p>Die Fachmittelschulen (FMS), die Handelsmittelschule (HMS) und die Informatikmittelschule (IMS) werden zu den Mittelschulen gezählt. Die Brückenangebote werden bei der Berufsbildung dazu gezählt.</p>","descriptionHide":true,"source":"Bildungsplanung Kanton Zürich, Statistik des Schulpersonals","readingExampleHide":false,"readingExampleContent":"<p>Im Schuljahr 2025/26 waren Personen mit 1'774.6 Vollzeiteinheiten an öffentlich finanzierten Mittelschulen im Kanton im Unterricht tätig.</p>","dataLimitsHide":true,"dataLimitsContent":"","statusDate":"2026-11-09T11:19:49.770","columns":[{"columnKey":"Schuljahr","columnName":"Schuljahr","type":"year","order":0,"responsivePriority":0,"display":true,"filter":false,"displayTooltip":false,"displayX":true,"displayLine":false},{"columnKey":"Schultyp","columnName":"Schultyp","type":"string","order":1,"responsivePriority":0,"display":true,"filter":false,"displayTooltip":true,"displayX":false,"displayLine":true},{"columnKey":"Vollzeiteinheiten","columnName":"Vollzeiteinheiten","type":"float","order":2,"responsivePriority":0,"display":true,"filter":false,"displayTooltip":true,"displayX":false,"displayLine":true}]},"chart":{"charttype":"multiline","fullscreen":true,"embed":true,"downloadpng":true,"downloadsvg":true,"downloadcsv":true,"downloadxlsx":true,"downloadcsvall":false,"downloadxlsxall":false,"fixedScale":true,"showTotal":true,"xVariable":"Schuljahr","yVariable":"Vollzeiteinheiten","zVariable":"Schultyp","ordergroupsby":{"orderby":"list","order":["Mittelschule","Berufsbildung"]}}}