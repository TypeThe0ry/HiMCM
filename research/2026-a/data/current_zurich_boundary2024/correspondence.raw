<script type="text/javascript">
    const HUMAN_TRANSLATED_LANGS = ['en', 'fr', 'de'];
    
    function updateWebComponentLabels(targetLang) {
        const navTrees = document.querySelectorAll('navigation-full-tree');
        
        navTrees.forEach(nav => {
            const databaseLabel = nav.getAttribute(`data-database-${targetLang}`);
            const tablesLabel = nav.getAttribute(`data-tables-${targetLang}`);
            const tbeuLabel = nav.getAttribute(`data-tbeu-${targetLang}`);
            
            if (databaseLabel) nav.setAttribute('databaseLabel', databaseLabel);
            if (tablesLabel) nav.setAttribute('tablesLabel', tablesLabel);
            if (tbeuLabel) nav.setAttribute('tbeuLabel', tbeuLabel);
        });
    }
    
    window.addEventListener('wtTranslationStart', function(e) {
        const targetLang = e.parameters.target;
        const navTrees = document.querySelectorAll('navigation-tree, navigation-full-tree');
        
        navTrees.forEach(nav => {
            if (HUMAN_TRANSLATED_LANGS.includes(targetLang)) {
                nav.setAttribute('translate', 'no');
            } else {
                nav.setAttribute('translate', 'yes');
            }
        });
    });
    
    window.addEventListener('wtTranslationEnd', function(e) {
        const element = document.querySelector('.ecl-site-header__language');
        if (element) {
            element.hidden = true;
        }
        
        const targetLang = $wt.etrans.targetLanguage;
        
        if (targetLang && HUMAN_TRANSLATED_LANGS.includes(targetLang)) {
            const navTrees = document.querySelectorAll('navigation-tree, navigation-full-tree');
            navTrees.forEach(nav => {
                nav.setAttribute('language', targetLang);
            });
            
            updateWebComponentLabels(targetLang);
        }
    });
</script>
