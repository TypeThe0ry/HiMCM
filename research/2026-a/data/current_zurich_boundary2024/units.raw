		<main id="main" tabindex="-1">
<h1>Urban audit 2024 units</h1>
<p class="lead">One GeoJSON file per unit (for example a country or a region), scale and projection. Find a unit by its code, then download the file you need.</p>
<ul class="inline-links">
	<li><a href="urau-2024-units.json">Unit list as JSON (<code>urau-2024-units.json</code>)</a></li>
	<li><a href="#naming">How files are named</a></li>
</ul>
<div class="notice" role="note">
	<p>Specific <a href="https://ec.europa.eu/eurostat/web/gisco/geodata/administrative-units">download provisions</a> apply to these datasets. By downloading or using the data, you accept them.</p>
	
</div>

<section id="units" class="section" aria-labelledby="units-heading">
	<h2 id="units-heading">Units by country <small>(30)</small></h2>
	<div class="filter" data-filter="units" hidden>
	<label class="filter__label" for="filter-input">Filter units</label>
	<p class="filter__hint" id="filter-hint">Unit code and file name parts, for example: DE21 or BE 4326 region</p>
	<input class="filter__input" id="filter-input" type="search" autocomplete="off" spellcheck="false" aria-describedby="filter-hint filter-status">
	<p class="filter__status" id="filter-status" role="status" aria-live="polite"></p>
</div>
<script>
// Runs once the whole list below has been parsed
document.addEventListener('DOMContentLoaded', function () {
	'use strict';
	var MAX_OPEN = 400;  // open groups of files only while the result stays readable
	var MAX_GROUPS = 60; // open groups of groups (e.g. countries) up to this number

	function openTarget() {
		var id = decodeURIComponent(location.hash.slice(1));
		var el = id && document.getElementById(id);
		if (!el) return;
		for (var p = el; p; p = p.parentElement) {
			if (p.tagName === 'DETAILS') p.open = true;
		}
		el.scrollIntoView();
	}
	window.addEventListener('hashchange', openTarget);
	openTarget();

	var box = document.querySelector('[data-filter]');
	var root = box && document.getElementById(box.getAttribute('data-filter'));
	if (!root) return;
	box.hidden = false;
	var input = box.querySelector('input');
	var status = box.querySelector('[role=status]');

	// Index the list once. A group is a <details> in an <li>; an item is an <li> with a file link.
	function build(details) {
		var node = { li: details.parentElement, details: details, groups: [], items: [],
			text: details.querySelector('summary').textContent.toLowerCase() };
		var lists = details.children;
		for (var i = 0; i < lists.length; i++) {
			if (lists[i].tagName !== 'UL') continue;
			var lis = lists[i].children;
			for (var j = 0; j < lis.length; j++) {
				var first = lis[j].firstElementChild;
				if (first && first.tagName === 'DETAILS') node.groups.push(build(first));
				else node.items.push({ li: lis[j], text: lis[j].textContent.toLowerCase() });
			}
		}
		return node;
	}
	var tops = Array.prototype.map.call(root.querySelectorAll(':scope > ul > li > details'), build);

	function matches(text, terms) {
		for (var i = 0; i < terms.length; i++) if (text.indexOf(terms[i]) < 0) return false;
		return true;
	}
	// Shows the whole group; returns its number of items
	function showAll(node) {
		node.li.hidden = false;
		for (var i = 0; i < node.items.length; i++) node.items[i].li.hidden = false;
		var n = node.items.length;
		for (var j = 0; j < node.groups.length; j++) n += showAll(node.groups[j]);
		return n;
	}
	// Hides what does not match; returns the number of matching items and collects the groups to open
	function filter(node, terms, toOpen) {
		var n = 0;
		if (matches(node.text, terms)) {
			n = showAll(node);
		} else {
			for (var i = 0; i < node.items.length; i++) {
				var ok = matches(node.items[i].text, terms);
				node.items[i].li.hidden = !ok;
				if (ok) n++;
			}
			for (var j = 0; j < node.groups.length; j++) n += filter(node.groups[j], terms, toOpen);
		}
		node.li.hidden = n === 0;
		if (n) toOpen.push(node);
		return n;
	}
	function expand(nodes) {
		nodes.forEach(function (node) {
			if (!node.details.open) { node.details.open = true; openedByFilter.push(node.details); }
		});
	}

	var openedByFilter = [];
	function run() {
		var q = input.value.trim().toLowerCase();
		var terms = q ? q.split(/\s+/) : [];
		openedByFilter.forEach(function (d) { d.open = false; });
		openedByFilter = [];
		if (!terms.length) {
			tops.forEach(showAll);
			status.textContent = '';
			return;
		}
		var total = 0, toOpen = [];
		tops.forEach(function (node) { total += filter(node, terms, toOpen); });
		// Groups of groups (countries) open up to MAX_GROUPS; groups of files open while the result stays short
		var containers = toOpen.filter(function (node) { return node.groups.length; });
		var leaves = toOpen.filter(function (node) { return !node.groups.length; });
		if (containers.length <= MAX_GROUPS) expand(containers);
		if (total <= MAX_OPEN) expand(leaves);
		status.textContent = total === 0
			? 'No files match “' + q + '”.'
			: total + (total === 1 ? ' file matches' : ' files match')
				+ (total > MAX_OPEN && leaves.length > 1 ? ' in ' + leaves.length + ' groups. Open one to see its files, or refine the filter.' : '.');
	}
	// Keep the filter in the URL (?filter=DE21), so a filtered list can be shared or reloaded
	function saveToUrl() {
		if (!window.URL || !history.replaceState) return;
		var url = new URL(location.href);
		if (input.value.trim()) url.searchParams.set('filter', input.value.trim());
		else url.searchParams.delete('filter');
		history.replaceState(null, '', url);
	}
	var timer;
	input.addEventListener('input', function () {
		clearTimeout(timer);
		timer = setTimeout(function () { run(); saveToUrl(); }, 150);
	});
	var initial = window.URLSearchParams && new URLSearchParams(location.search).get('filter');
	if (initial) {
		input.value = initial;
		run();
	}
});
</script>
